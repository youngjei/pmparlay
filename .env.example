API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://localhost:5173
VITE_ALLOW_DIRECT_POLYMARKET_FALLBACK=false
MARKET_CACHE_TTL_MS=30000
MARKET_CATALOG_MAX_AGE_MS=30000
MARKET_CATALOG_HARD_MAX_AGE_MS=1800000
MARKET_INDEX_INTERVAL_MS=60000
MARKET_INDEX_MAX_PAGES=1
WORKER_HEARTBEAT_MAX_AGE_MS=45000
WORKER_SUCCESS_MAX_AGE_MS=180000
MARKET_QA_MAX_COMPLETION_AGE_MS=21600000
MARKET_QA_MAX_PROGRESS_AGE_MS=300000
MARKET_QA_MAX_SNAPSHOT_AGE_MS=21600000
MARKET_QA_MAX_DB_LATENCY_MS=2500
MARKET_QA_LIMIT=12
FRONTEND_QA_MAX_INITIAL_GZIP_BYTES=250000
FRONTEND_QA_MAX_WALLET_RUNTIME_GZIP_BYTES=650000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_SKIP_ON_REDIS_ERROR=false

# Local smoke tests can run in play-money mode.
# Supervised Sepolia house-book USDC mode requires treasury, RPC, and Privy config:
# ACCOUNTING_MODE=house_book_usdc
# LEDGER_CURRENCY=USDC
# SETTLEMENT_CHAIN_ID=11155111
ACCOUNTING_MODE=play_money
LEDGER_CURRENCY=USD
SETTLEMENT_CHAIN_ID=11155111
MAX_USER_LIABILITY_USD=100
MAX_MARKET_LIABILITY_USD=250
MAX_EVENT_LIABILITY_USD=250

# Privy auth. App ID is public; do not commit app secrets.
VITE_ENABLE_PRIVY=true
VITE_PRIVY_APP_ID=cmr8w638r01zw0djs68l0yfy3
VITE_WALLETCONNECT_PROJECT_ID=9d411c24f4f2aead9d0f3bbac5842134
VITE_SETTLEMENT_CHAIN_ID=11155111
VITE_USDC_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
PRIVY_APP_ID=cmr8w638r01zw0djs68l0yfy3
PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/cmr8w638r01zw0djs68l0yfy3/jwks.json

# Local Docker Postgres. Set a unique, URL-safe value before running Docker Compose.
# POSTGRES_PASSWORD is required by docker-compose.yml; use the same value in the host-local DATABASE_URL.
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://legwork:<POSTGRES_PASSWORD>@127.0.0.1:5432/legwork
# Small supervised staging pool. Defaults: 5 connections, 5s acquisition, 15s statements.
# DATABASE_POOL_MAX=5
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=15000
REDIS_URL=redis://127.0.0.1:6379

# Add later when auth is implemented. Generate a long random value.
# AUTH_SECRET=

# Required before exposing /api/ops/* outside local development.
# OPS_API_KEY=

# Required before running the USDC deposit scanner in house-book mode.
# TREASURY_SAFE_ADDRESS=
# Required staging preflight pin for the independently approved Safe owner.
# STAGING_EXPECTED_SAFE_OWNER=
# Backend-only Safe Infrastructure API auth. Never expose as VITE_* or in browser code.
SAFE_API_BASE_URL=https://api.safe.global
# SAFE_API_KEY=
# Sepolia payment/deposit RPC during staging.
# ETHEREUM_RPC_URL=
USDC_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
USDC_REQUIRED_CONFIRMATIONS=12
# USDC_DEPOSIT_START_BLOCK=
USDC_DEPOSIT_SCAN_LOOKBACK_BLOCKS=5000
USDC_DEPOSIT_SCAN_BATCH_BLOCKS=2000
USDC_DEPOSIT_POLL_INTERVAL_MS=30000

# Supervised Sepolia may use Polymarket's Gamma+CLOB API agreement. Mainnet
# must revisit whether to require Polygon CTF quorum.
SETTLEMENT_AUTHORITY=polymarket_api
SETTLEMENT_API_STABILITY_MS=120000
POLYMARKET_SETTLEMENT_API_TIMEOUT_MS=10000
POLYMARKET_GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_BASE_URL=https://clob.polymarket.com

# Polygon mainnet CTF settlement authority (currently deferred for Sepolia).
POLYGON_SETTLEMENT_CHAIN_ID=137
SETTLEMENT_RPC_QUORUM=2
SETTLEMENT_ALERT_BATCH_SIZE=250
SETTLEMENT_OVERDUE_WARNING_MS=86400000
SETTLEMENT_OVERDUE_CRITICAL_MS=259200000
# POLYGON_RPC_URL=
# POLYGON_RPC_OPERATOR=
# POLYGON_SECONDARY_RPC_URL=
# POLYGON_SECONDARY_RPC_OPERATOR=
# POLYGON_TERTIARY_RPC_URL=
# POLYGON_TERTIARY_RPC_OPERATOR=

# Add later when external monitoring is enabled.
# SENTRY_DSN=
