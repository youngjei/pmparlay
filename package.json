{
  "name": "legwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "sh -c 'trap \"kill 0\" EXIT; npm run dev:api & npm run worker:markets & npm run worker:deposits & npm run worker:reconciliation & npm run worker:settlements & npm run dev'",
    "dev:api": "tsx watch server/index.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:stats": "tsx server/db/stats.ts",
    "db:latest": "tsx server/db/latest.ts",
    "db:maintenance": "tsx server/db/maintenance.ts",
    "db:backfill-settlement-identities": "tsx server/backfillSettlementIdentities.ts",
    "house:fund": "tsx server/recordHouseFunding.ts",
    "staging:provision": "tsx server/provisionSepoliaStaging.ts",
    "staging:reset": "bash scripts/staging-reset.sh",
    "staging:migrate": "bash scripts/staging-node.sh server/db/migrate.ts",
    "staging:backfill": "bash scripts/staging-node.sh server/backfillSettlementIdentities.ts",
    "staging:qa": "bash scripts/staging-node.sh server/qaSepoliaStaging.ts",
    "staging:qa:open": "bash scripts/staging-node.sh server/qaSepoliaStaging.ts --require-open",
    "staging:run": "bash scripts/staging-run.sh",
    "staging:web": "bash scripts/staging-web.sh",
    "staging:house:fund": "bash scripts/staging-node.sh server/recordHouseFunding.ts",
    "staging:worker:markets": "bash scripts/staging-node.sh server/workers/marketIndexerWorker.ts",
    "staging:worker:deposits": "bash scripts/staging-node.sh server/workers/usdcDepositScannerWorker.ts",
    "staging:worker:reconciliation": "bash scripts/staging-node.sh server/workers/reconciliationWorker.ts",
    "staging:worker:settlements": "bash scripts/staging-node.sh server/workers/settlementResolverWorker.ts",
    "staging:backup": "bash scripts/staging-backup.sh",
    "staging:restore-rehearsal": "bash scripts/staging-restore-rehearsal.sh",
    "index:markets": "tsx server/indexMarkets.ts",
    "qa:markets": "tsx server/qaMarketCatalog.ts",
    "qa:market-performance": "tsx server/qaMarketPerformance.ts",
    "qa:market-performance:ci": "vitest run --maxWorkers=1 server/tests/marketRepository.integration.test.ts -t \"keeps maximum-size discovery pages paginated within the database budget\"",
    "qa:frontend-bundle": "tsx server/qaFrontendBundle.ts",
    "qa:bot-wallet": "bash scripts/staging-node.sh server/qaSepoliaBotWallet.ts",
    "qa:bot-lifecycle-preflight": "bash scripts/staging-bot-lifecycle-preflight.sh",
    "staging:qa:lifecycle": "bash scripts/staging-bot-lifecycle.sh",
    "queue:index-markets": "tsx server/workers/enqueueMarketIndex.ts",
    "worker:markets": "tsx server/workers/marketIndexerWorker.ts",
    "worker:outbox": "tsx server/workers/outboxWorker.ts",
    "worker:settlements": "tsx server/workers/settlementResolverWorker.ts",
    "worker:deposits": "tsx server/workers/usdcDepositScannerWorker.ts",
    "worker:reconciliation": "tsx server/workers/reconciliationWorker.ts",
    "worker:health": "tsx server/workers/checkHeartbeat.ts",
    "build": "tsc && vite build",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:financial:postgres": "vitest run server/tests/financialControlsPostgres.test.ts",
    "test:postgres": "vitest run --maxWorkers=1 server/tests/directPayMigration.test.ts server/tests/financialControlsPostgres.test.ts server/tests/houseFundingMigrationPostgres.test.ts server/tests/marketRepository.integration.test.ts server/tests/onchainTransferOwnershipPostgres.test.ts server/tests/onchainTransferClaimConstraintsPostgres.test.ts server/tests/polymarketApiSettlementPostgres.test.ts server/tests/settlementClaimsPostgres.test.ts server/tests/settlementIdentityPostgres.test.ts server/tests/settlementOperationalAlertsPostgres.test.ts server/tests/settlementReplayPostgres.test.ts server/tests/withdrawalCancellationPostgres.test.ts server/tests/workerHeartbeatRepositoryPostgres.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:wallet": "playwright test --config playwright.wallet.config.ts",
    "test:e2e:privy": "PRIVY_E2E=1 playwright test --config playwright.privy.config.ts",
    "start:api": "tsx server/index.ts",
    "start:worker:markets": "tsx server/workers/marketIndexerWorker.ts",
    "start:worker:outbox": "tsx server/workers/outboxWorker.ts",
    "start:worker:settlements": "tsx server/workers/settlementResolverWorker.ts",
    "start:worker:deposits": "tsx server/workers/usdcDepositScannerWorker.ts",
    "start:worker:reconciliation": "tsx server/workers/reconciliationWorker.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@privy-io/node": "^0.24.0",
    "@privy-io/react-auth": "^3.33.1",
    "bullmq": "^5.79.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.1",
    "viem": "^2.54.5",
    "zod": "^4.4.3"
  },
  "overrides": {
    "viem": "$viem",
    "@walletconnect/ethereum-provider": "2.23.10",
    "@walletconnect/universal-provider": "2.23.10",
    "@walletconnect/sign-client": "2.23.10",
    "@walletconnect/core": "2.23.10",
    "@walletconnect/utils": "2.23.10",
    "uuid": "11.1.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.6"
  }
}
